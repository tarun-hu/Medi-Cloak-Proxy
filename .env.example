# ==============================================================================
# MediCloak Environment Configuration Template
# Copy this file to .env and configure your secrets
# ==============================================================================

# Database connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/medicloak

# Admin and DPO security clearance key
ADMIN_API_KEY=medicloak-dpo-secret-2026

# Optional VAPI Voice alerting
VAPI_ENABLED=false
VAPI_API_KEY=your_vapi_private_api_key
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_ASSISTANT_ID=your_vapi_assistant_id
ALERT_PHONE_NUMBER=+91XXXXXXXXXX
CALL_COOLDOWN_SECONDS=300
